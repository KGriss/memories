{% extends 'base.html.twig' %}

{% block title %}Détail du souvenir{% endblock %}

{% block main %}
<h1>{{ memory.name }}</h1>

<p><strong>Description :</strong> {{ memory.description }}</p>

{% if memory.location %}
    <p><strong>Lieu :</strong> {{ memory.location }}</p>
{% endif %}

{% if memory.imageName %}
    <p><img class="img-fluid" src="{{ vich_uploader_asset(memory, 'imageFile') }}"/></p>
{% endif %}

{% set bookmarks = app.session.get('bookmarks')|default([]) %}
<p>
    <a href="{{ path('app_travel_memory_mark', {'travel_id': travel.id, 'memory_id': memory.id}) }}">
    {% if memory.id in bookmarks %}
        ★ Favori (retirer des favoris)
    {% else %}
        ☆ Ajouter aux favoris
    {% endif %}
    </a>
</p>

<p>
    <a href="{{ path('app_travel_show', { 'id': travel.id}) }}">back to travel</a>
</p>
{% endblock %} {# main #}
