{% extends 'base.html.twig' %}

{% block title %}Travel index{% endblock %}

{% block main %}
    <h1>Travel index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Published</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for travel in travel %}
            <tr>
                <td>{{ travel.id }}</td>
                <td>{{ travel.name }}</td>
                <td>{{ travel.description }}</td>
                <td>{{ travel.published ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_travel_show', {'id': travel.id}) }}">show</a>
                    {% if is_granted('ROLE_ADMIN') or (app.user and app.user == travel.creator) %}
                        <a href="{{ path('app_travel_edit', {'id': travel.id}) }}">edit</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %} {# main #}
