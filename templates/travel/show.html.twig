{% extends 'base.html.twig' %}

{% block title %}Travel{% endblock %}

{% block main %}
    <h1>Travel</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ travel.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ travel.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ travel.description }}</td>
            </tr>
            <tr>
                <th>Published</th>
                <td>{{ travel.published ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Creator</th>
                <td>{{ travel.creator.name }}</td>
            </tr>
            <tr>
                <th>Memories</th>
                <td>
                    <ul>
                      {% for memory in travel.memories %}
                      <li>
                        <a href="{{ path( 'app_travel_memory_show',
                                          {
                                            'travel_id': travel.id,
                                            'memory_id' : memory.id
                                          }
                                        ) }}">{{ memory }}</a>
                      </li>
                      {% endfor %}
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_travel_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') or (app.user and app.user == travel.creator) %}
        <a href="{{ path('app_travel_edit', {'id': travel.id}) }}">edit</a>

        {{ include('travel/_delete_form.html.twig') }}
    {% endif %}
{% endblock %} {# main #}
