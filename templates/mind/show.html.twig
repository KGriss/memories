{% extends 'base.html.twig' %}

{% block title %}Détail de l'inventaire{% endblock %}

{% block main %}
<h1>{{ mind.description }}</h1>

<p>Propriétaire : {{ mind.member.email }}</p>

<h2>Souvenirs</h2>

{% if mind.memories is empty %}
    <p>Cet inventaire ne contient aucun souvenir.</p>
{% else %}
    <ul>
        {% for memory in mind.memories %}
            <li>
                <strong><a href="{{ path('app_memory_show', {id: memory.id}) }}">{{ memory.name }}</a></strong>

                {% if memory.location %}
                    - {{ memory.location }}
                {% endif %}

                <p>{{ memory.description }}</p>
            </li>
        {% endfor %}
    </ul>
{% endif %}

<p>
    <a href="{{ path('app_mind') }}">Retour à la liste</a>
</p>
{% endblock %} {# main #}
