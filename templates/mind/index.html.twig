{% extends 'base.html.twig' %}

{% block title %}Liste des inventaires{% endblock %}

{% block body %}
<h1>Liste des inventaires</h1>

{% if minds is empty %}
    <p>Aucun inventaire n'a été trouvé.</p>
{% else %}
    <ul>
        {% for mind in minds %}
            <li>
                {{ mind.description }}
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% endblock %}
