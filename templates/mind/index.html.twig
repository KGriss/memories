{% extends 'base.html.twig' %}

{% block title %}Liste des inventaires{% endblock %}

{% block main %}
<h1>Liste des inventaires</h1>

{% if minds is empty %}
    <p>Aucun inventaire n'a été trouvé.</p>
{% else %}
    <ul>
        {% for mind in minds %}
            <li>
                <a href="{{ path('app_mind_show', {id: mind.id}) }}">{{ mind.description }}</a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% endblock %} {# main #}
