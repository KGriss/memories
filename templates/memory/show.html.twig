{% extends 'base.html.twig' %}

{% block title %}Memory{% endblock %}

{% block main %}
    <h1>Memory</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ memory.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ memory.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ memory.description }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ memory.location }}</td>
            </tr>
            <tr>
                <th>Picture</th>
                <td>{{ memory.picture }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_memory_index') }}">back to list</a>

    <a href="{{ path('app_memory_edit', {'id': memory.id}) }}">edit</a>

    {{ include('memory/_delete_form.html.twig') }}
{% endblock %} {# main #}
