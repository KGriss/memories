{% extends 'base.html.twig' %}

{% block title %}Detail du souvenir{% endblock %}

{% block body %}
<h1>{{ memory.name }}</h1>

<p><strong>Description :</strong> {{ memory.description }}</p>

{% if memory.location %}
    <p><strong>Lieu :</strong> {{ memory.location }}</p>
{% endif %}

{% if memory.picture %}
    <p><strong>Image :</strong> {{ memory.picture }}</p>
{% endif %}

<p>
    <a href="/mind/{{ memory.mind.id }}">Retour a l inventaire</a>
</p>
{% endblock %}
