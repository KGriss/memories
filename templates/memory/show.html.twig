{% extends 'base.html.twig' %}

{% block title %}Détail du souvenir{% endblock %}

{% block main %}
<h1>{{ memory.name }}</h1>

<p><strong>Description :</strong> {{ memory.description }}</p>

{% if memory.location %}
    <p><strong>Lieu :</strong> {{ memory.location }}</p>
{% endif %}

{% if memory.picture %}
    <p><strong>Image :</strong> {{ memory.picture }}</p>
{% endif %}

<p>
    <a href="{{ path('app_mind_show', {id: memory.mind.id}) }}">Retour à l'inventaire</a>
</p>
{% endblock %} {# main #}
