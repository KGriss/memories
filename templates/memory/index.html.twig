{% extends 'base.html.twig' %}

{% block title %}Memory index{% endblock %}

{% block main %}
    <h1>Memory index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Location</th>
                <th>Picture</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for memory in memories %}
            <tr>
                <td>{{ memory.id }}</td>
                <td>{{ memory.name }}</td>
                <td>{{ memory.description }}</td>
                <td>{{ memory.location }}</td>
                <td>{{ memory.picture }}</td>
                <td>
                    <a href="{{ path('app_memory_show', {'id': memory.id}) }}">show</a>
                    <a href="{{ path('app_memory_edit', {'id': memory.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %} {# main #}
